--- /dev/null
+++ source/board_top.sv
@@ -0,0 +1,17 @@
+`timescale 1ns/1ps
+// MES2L676-100HP: KEY0 reset, KEY1..4 GPIO low nibble, eight LEDs, TX only.
+// CPU, peripheral cores/wrapper, address map and memory protocol unchanged.
+module board_top(input wire clk, input wire [4:0] key_n,
+                 output wire uart_tx, output wire [7:0] led);
+    wire sys_rst_n;
+    wire [7:0] gpio_keys = {4'b0000, ~key_n[4:1]};
+    wire stopped, write_error;
+    wire [1:0] stop_kind;
+    wire [31:0] stop_pc;
+    board_reset_sync reset_sync(.clk(clk), .key0_n(key_n[0]),
+                                .sys_rst_n(sys_rst_n));
+    soc_top #(.CLKS_PER_BIT(234)) soc(
+        .clk(clk), .rst_n(sys_rst_n), .gpio_in_async(gpio_keys),
+        .uart_tx(uart_tx), .gpio_out(led), .stopped(stopped),
+        .stop_kind(stop_kind), .stop_pc(stop_pc), .write_error(write_error));
+endmodule
--- /dev/null
+++ source/board_reset_sync.sv
@@ -0,0 +1,12 @@
+`timescale 1ns/1ps
+// KEY0: asynchronous assertion, three rising edges to synchronous release.
+// No debouncing, minimum pulse guarantee or physical MTBF claim.
+module board_reset_sync(input wire clk, input wire key0_n,
+                        output wire sys_rst_n);
+    reg [2:0] release_ff = 3'b000;
+    always @(posedge clk or negedge key0_n) begin
+        if (!key0_n) release_ff <= 3'b000;
+        else release_ff <= {release_ff[1:0], 1'b1};
+    end
+    assign sys_rst_n = release_ff[2];
+endmodule
